# Link Mage Environment Variables
# Copy this file to .env and fill in your values

# GeoLite2 Database Path (optional)
# If not set, the application will search standard locations
# GEOIP_DB=/path/to/GeoLite2-City.mmdb

# API Keys (optional - can also be set in-app via Settings)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Plugin Directory (optional)
# PLUGIN_DIR=/path/to/plugins

# Log Level (optional)
# RUST_LOG=info
