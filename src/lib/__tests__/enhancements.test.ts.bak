/**
 * Automated Tests for Link Mage Enhancements
 * 
 * Tests for: Provenance, Annotations, Tags, Pipelines, Filters, Statistics
 * 
 * Note: These are type-checked test specifications.
 * Run with: vitest (requires vitest installation)
 */

import { get } from 'svelte/store';

// Import stores and utilities
import { graphStore, selectionStore } from '../stores';
import { filterCriteria, filteredGraph, resetFilters, FILTER_PRESETS } from '../filterStore';
import { annotationStore, tagStore, ANNOTATION_COLORS } from '../stores/annotations';
import { calculateStats, getTopHubs, getIsolatedNodes, calculateCentrality, formatStats } from '../utils/graphStats';
import { 
  createManualProvenance, 
  createTransformProvenance, 
  addTransformStep,
  calculateConfidence,
  SOURCE_RELIABILITY 
} from '../types/provenance';
import type { Node, Edge } from '../stores';

// ── Helper Functions ──────────────────────────────────────────────────────────

function createTestNode(type: string, value: string, id?: string): Node {
  return {
    id: id || `test_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
    type,
    properties: {
      label: value,
      value: value,
    },
  };
}

function createTestEdge(source: string, target: string, label = 'test-edge'): Edge {
  return {
    id: `edge_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
    source,
    target,
    label,
    properties: {},
  };
}

// ── Provenance Tests ──────────────────────────────────────────────────────────

describe('Data Provenance', () => {
  describe('createManualProvenance', () => {
    it('should create provenance with manual source', () => {
      const provenance = createManualProvenance('test_user');
      
      expect(provenance.source).toBe('manual');
      expect(provenance.createdBy).toBe('test_user');
      expect(provenance.confidence).toBe(1.0);
      expect(provenance.transformChain).toHaveLength(0);
      expect(provenance.createdAt).toBeDefined();
    });

    it('should default to "user" as creator', () => {
      const provenance = createManualProvenance();
      expect(provenance.createdBy).toBe('user');
    });
  });

  describe('createTransformProvenance', () => {
    it('should create provenance with transform source', () => {
      const provenance = createTransformProvenance(
        'dns_lookup',
        'node_123',
        'DNS Lookup',
        'system',
        150,
        'example.com'
      );

      expect(provenance.source).toBe('dns_lookup');
      expect(provenance.createdBy).toBe('system');
      expect(provenance.transformChain).toHaveLength(1);
      expect(provenance.transformChain[0].transformName).toBe('DNS Lookup');
      expect(provenance.transformChain[0].sourceNodeId).toBe('node_123');
      expect(provenance.transformChain[0].durationMs).toBe(150);
      expect(provenance.externalRef).toBe('example.com');
    });

    it('should set confidence based on source', () => {
      const dnsProv = createTransformProvenance('dns_lookup', 'node_1', 'DNS', 'system');
      const whoisProv = createTransformProvenance('whois_lookup', 'node_2', 'WHOIS', 'system');
      
      expect(dnsProv.confidence).toBeCloseTo(0.95, 2);
      expect(whoisProv.confidence).toBeCloseTo(0.90, 2);
    });
  });

  describe('addTransformStep', () => {
    it('should add step to existing provenance', () => {
      const initial = createManualProvenance('user');
      const updated = addTransformStep(initial, 'DNS Lookup', 'node_123', 100, true);

      expect(updated.transformChain).toHaveLength(1);
      expect(updated.transformChain[0].transformName).toBe('DNS Lookup');
      expect(updated.confidence).toBeLessThan(1.0); // Decayed
    });

    it('should track multiple steps', () => {
      let provenance = createManualProvenance('user');
      provenance = addTransformStep(provenance, 'Step 1', 'node_1', 50, true);
      provenance = addTransformStep(provenance, 'Step 2', 'node_2', 75, true);
      provenance = addTransformStep(provenance, 'Step 3', 'node_3', 100, true);

      expect(provenance.transformChain).toHaveLength(3);
      expect(provenance.transformChain[2].transformName).toBe('Step 3');
    });

    it('should record failed transforms', () => {
      const initial = createManualProvenance('user');
      const updated = addTransformStep(initial, 'Failed Transform', 'node_1', 100, false, 'Error message');

      expect(updated.transformChain[0].success).toBe(false);
      expect(updated.transformChain[0].error).toBe('Error message');
    });
  });

  describe('calculateConfidence', () => {
    it('should decay confidence with each step', () => {
      const base = SOURCE_RELIABILITY.manual; // 1.0
      
      const after1 = calculateConfidence('manual', [{ transformName: 'A', sourceNodeId: '1', executedAt: '2024-01-01', status: 'success', nodesAdded: 0, edgesAdded: 0, durationMs: 0 } as any]);
      const after2 = calculateConfidence('manual', [
        { transformName: 'A', sourceNodeId: '1', executedAt: '2024-01-01', status: 'success', nodesAdded: 0, edgesAdded: 0, durationMs: 0 } as any,
        { transformName: 'B', sourceNodeId: '2', executedAt: '2024-01-01', status: 'success', nodesAdded: 0, edgesAdded: 0, durationMs: 0 } as any,
      ]);

      expect(after1).toBeLessThan(base);
      expect(after2).toBeLessThan(after1);
    });

    it('should respect minimum confidence floor', () => {
      const manySteps = Array(100).fill({ transformName: 'Step', sourceNodeId: 'x', executedAt: '2024-01-01', status: 'success', nodesAdded: 0, edgesAdded: 0, durationMs: 0 });
      const confidence = calculateConfidence('manual', manySteps as any);
      
      expect(confidence).toBeGreaterThanOrEqual(0.1);
    });
  });

  describe('SOURCE_RELIABILITY', () => {
    it('should have all expected sources', () => {
      expect(SOURCE_RELIABILITY.manual).toBe(1.0);
      expect(SOURCE_RELIABILITY.dns_lookup).toBe(0.95);
      expect(SOURCE_RELIABILITY.whois_lookup).toBe(0.90);
      expect(SOURCE_RELIABILITY.geoip_lookup).toBe(0.85);
      expect(SOURCE_RELIABILITY.web_scrape).toBe(0.75);
      expect(SOURCE_RELIABILITY.virustotal).toBe(0.95);
      expect(SOURCE_RELIABILITY.remote_transform).toBe(0.70);
      expect(SOURCE_RELIABILITY.plugin).toBe(0.80);
      expect(SOURCE_RELIABILITY.import).toBe(0.85);
      expect(SOURCE_RELIABILITY.unknown).toBe(0.50);
    });
  });
});

// ── Annotation & Tag Tests ────────────────────────────────────────────────────

describe('Annotations & Tags', () => {
  beforeEach(() => {
    annotationStore.clear();
    tagStore.clear();
  });

  describe('annotationStore', () => {
    it('should add annotation', () => {
      const annotation = annotationStore.add({
        entityId: 'node_123',
        entityType: 'node',
        text: 'Test annotation',
        color: 'yellow',
        createdBy: 'tester',
        pinned: false,
      });

      expect(annotation.id).toBeDefined();
      expect(annotation.text).toBe('Test annotation');
      expect(annotation.color).toBe('yellow');
      
      const all = annotationStore.export();
      expect(all).toHaveLength(1);
    });

    it('should update annotation', () => {
      const annotation = annotationStore.add({
        entityId: 'node_123',
        entityType: 'node',
        text: 'Original',
        color: 'yellow',
        createdBy: 'user',
        pinned: false,
      });

      const updated = annotationStore.update(annotation.id, {
        text: 'Updated text',
        pinned: true,
      });

      expect(updated).toBe(true);
      const annotations = annotationStore.getByEntity('node_123');
      expect(annotations[0].text).toBe('Updated text');
      expect(annotations[0].pinned).toBe(true);
    });

    it('should remove annotation', () => {
      const annotation = annotationStore.add({
        entityId: 'node_123',
        entityType: 'node',
        text: 'To delete',
        color: 'red',
        createdBy: 'user',
        pinned: false,
      });

      const removed = annotationStore.remove(annotation.id);
      expect(removed).toBe(true);
      
      const all = annotationStore.export();
      expect(all).toHaveLength(0);
    });

    it('should get annotations by entity', () => {
      annotationStore.add({
        entityId: 'node_1',
        entityType: 'node',
        text: 'Annotation 1',
        color: 'yellow',
        createdBy: 'user',
        pinned: false,
      });
      annotationStore.add({
        entityId: 'node_2',
        entityType: 'node',
        text: 'Annotation 2',
        color: 'blue',
        createdBy: 'user',
        pinned: false,
      });

      const node1Anns = annotationStore.getByEntity('node_1');
      expect(node1Anns).toHaveLength(1);
      expect(node1Anns[0].text).toBe('Annotation 1');
    });
  });

  describe('tagStore', () => {
    it('should create tag', () => {
      const tag = tagStore.add({
        name: 'Important',
        color: '#ef4444',
      });

      expect(tag.id).toBeDefined();
      expect(tag.name).toBe('Important');
      expect(tag.color).toBe('#ef4444');
      expect(tag.usageCount).toBe(0);
    });

    it('should apply tag to entity', () => {
      const tag = tagStore.add({ name: 'Test', color: '#000' });
      const entityTag = tagStore.applyToEntity(tag.id, 'node_123', 'node', 'tester');

      expect(entityTag).not.toBeNull();
      expect(entityTag?.entityId).toBe('node_123');
      expect(entityTag?.tagId).toBe(tag.id);
      
      const tags = tagStore.getForEntity('node_123');
      expect(tags).toHaveLength(1);
    });

    it('should prevent duplicate tag applications', () => {
      const tag = tagStore.add({ name: 'Test', color: '#000' });
      tagStore.applyToEntity(tag.id, 'node_123', 'node');
      const result2 = tagStore.applyToEntity(tag.id, 'node_123', 'node');

      expect(result2).toBeNull(); // Already applied
    });

    it('should remove tag from entity', () => {
      const tag = tagStore.add({ name: 'Test', color: '#000' });
      tagStore.applyToEntity(tag.id, 'node_123', 'node');
      
      const removed = tagStore.removeFromEntity(tag.id, 'node_123');
      expect(removed).toBe(true);
      
      const tags = tagStore.getForEntity('node_123');
      expect(tags).toHaveLength(0);
    });

    it('should update usage count', () => {
      const tag = tagStore.add({ name: 'Popular', color: '#000' });
      tagStore.applyToEntity(tag.id, 'node_1', 'node');
      tagStore.applyToEntity(tag.id, 'node_2', 'node');
      tagStore.applyToEntity(tag.id, 'node_3', 'node');

      const tags = tagStore.export();
      expect(tags.tags[0].usageCount).toBe(3);
    });

    it('should get entities by tag', () => {
      const tag = tagStore.add({ name: 'Test', color: '#000' });
      tagStore.applyToEntity(tag.id, 'node_1', 'node');
      tagStore.applyToEntity(tag.id, 'node_2', 'edge');

      const entities = tagStore.getEntitiesWithTag(tag.id);
      expect(entities).toHaveLength(2);
      expect(entities.map(e => e.entityId)).toContain('node_1');
      expect(entities.map(e => e.entityId)).toContain('node_2');
    });
  });

  describe('ANNOTATION_COLORS', () => {
    it('should have all color values', () => {
      const { ANNOTATION_COLORS } = require('../stores/annotations');
      expect(ANNOTATION_COLORS.yellow).toBe('#fbbf24');
      expect(ANNOTATION_COLORS.green).toBe('#22c55e');
      expect(ANNOTATION_COLORS.blue).toBe('#3b82f6');
      expect(ANNOTATION_COLORS.purple).toBe('#a855f7');
      expect(ANNOTATION_COLORS.red).toBe('#ef4444');
      expect(ANNOTATION_COLORS.orange).toBe('#f97316');
    });
  });
});

// ── Filter Tests ──────────────────────────────────────────────────────────────

describe('Advanced Filtering', () => {
  beforeEach(() => {
    resetFilters();
    graphStore.setGraph({ nodes: [], edges: [] });
  });

  describe('FILTER_PRESETS', () => {
    it('should have high confidence preset', () => {
      expect(FILTER_PRESETS.highConfidence).toBeDefined();
      expect(FILTER_PRESETS.highConfidence.minConfidence).toBe(80);
    });

    it('should have hubs preset', () => {
      expect(FILTER_PRESETS.hubs).toBeDefined();
      expect(FILTER_PRESETS.hubs.minDegree).toBe(5);
    });

    it('should have isolated preset', () => {
      expect(FILTER_PRESETS.isolated).toBeDefined();
      expect(FILTER_PRESETS.isolated.hideIsolated).toBe(true);
    });

    it('should have recent preset', () => {
      expect(FILTER_PRESETS.recent).toBeDefined();
      expect(FILTER_PRESETS.recent.dateFrom).toBeDefined();
    });
  });

  describe('filterCriteria store', () => {
    it('should update node types', () => {
      filterCriteria.update(c => ({ ...c, nodeTypes: ['IP', 'Domain'] }));
      const criteria = get(filterCriteria);
      expect(criteria.nodeTypes).toContain('IP');
      expect(criteria.nodeTypes).toContain('Domain');
    });

    it('should update degree range', () => {
      filterCriteria.update(c => ({ ...c, minDegree: 2, maxDegree: 10 }));
      const criteria = get(filterCriteria);
      expect(criteria.minDegree).toBe(2);
      expect(criteria.maxDegree).toBe(10);
    });

    it('should reset to initial state', () => {
      filterCriteria.update(c => ({ 
        ...c, 
        nodeTypes: ['IP'],
        minDegree: 5,
        searchQuery: 'test',
      }));
      
      resetFilters();
      
      const criteria = get(filterCriteria);
      expect(criteria.nodeTypes).toHaveLength(0);
      expect(criteria.minDegree).toBe(0);
      expect(criteria.searchQuery).toBe('');
    });
  });

  describe('filteredGraph', () => {
    beforeEach(() => {
      // Set up test graph
      const nodes = [
        { id: 'n1', type: 'IP', properties: { label: '192.168.1.1', value: '192.168.1.1' } },
        { id: 'n2', type: 'Domain', properties: { label: 'example.com', value: 'example.com' } },
        { id: 'n3', type: 'IP', properties: { label: '8.8.8.8', value: '8.8.8.8' } },
      ];
      const edges = [
        { id: 'e1', source: 'n1', target: 'n2', label: 'resolves-to', properties: {} },
        { id: 'e2', source: 'n2', target: 'n3', label: 'related-to', properties: {} },
      ];
      graphStore.setGraph({ nodes, edges } as any);
    });

    it('should filter by node type', () => {
      filterCriteria.update(c => ({ ...c, nodeTypes: ['IP'] }));
      const filtered = get(filteredGraph);
      
      expect(filtered.nodes).toHaveLength(2);
      expect(filtered.nodes.every(n => n.type === 'IP')).toBe(true);
    });

    it('should filter by degree', () => {
      filterCriteria.update(c => ({ ...c, minDegree: 2 }));
      const filtered = get(filteredGraph);
      
      // Only n2 (example.com) has degree 2
      expect(filtered.nodes).toHaveLength(1);
      expect(filtered.nodes[0].id).toBe('n2');
    });

    it('should filter by search query', () => {
      filterCriteria.update(c => ({ ...c, searchQuery: 'example' }));
      const filtered = get(filteredGraph);
      
      expect(filtered.nodes).toHaveLength(1);
      expect(filtered.nodes[0].properties.label).toContain('example');
    });

    it('should update edges when nodes filtered', () => {
      filterCriteria.update(c => ({ ...c, nodeTypes: ['IP'] }));
      const filtered = get(filteredGraph);
      
      // Only edges connecting IP nodes should remain
      expect(filtered.edges).toHaveLength(0); // No IP-IP edges
    });
  });
});

// ── Graph Statistics Tests ────────────────────────────────────────────────────

describe('Graph Statistics', () => {
  describe('calculateStats', () => {
    it('should calculate basic stats', () => {
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'Domain', properties: {} },
          { id: 'n3', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'resolves', properties: {} },
          { id: 'e2', source: 'n2', target: 'n3', label: 'related', properties: {} },
        ],
      } as any;

      const stats = calculateStats(graph);

      expect(stats.totalNodes).toBe(3);
      expect(stats.totalEdges).toBe(2);
      expect(stats.nodesByType.IP).toBe(2);
      expect(stats.nodesByType.Domain).toBe(1);
    });

    it('should calculate degree statistics', () => {
      const graph = {
        nodes: [
          { id: 'center', type: 'Domain', properties: {} },
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'IP', properties: {} },
          { id: 'n3', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'center', target: 'n1', label: 'link', properties: {} },
          { id: 'e2', source: 'center', target: 'n2', label: 'link', properties: {} },
          { id: 'e3', source: 'center', target: 'n3', label: 'link', properties: {} },
        ],
      } as any;

      const stats = calculateStats(graph);

      expect(stats.maxDegree).toBe(3); // center node
      expect(stats.minDegree).toBe(1); // leaf nodes
      expect(stats.averageDegree).toBeCloseTo(1.5, 1);
    });

    it('should identify isolated nodes', () => {
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'Domain', properties: {} },
          { id: 'n3', type: 'IP', properties: {} }, // isolated
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'link', properties: {} },
        ],
      } as any;

      const stats = calculateStats(graph);
      expect(stats.isolatedNodes).toBe(1);
    });

    it('should identify hub nodes', () => {
      const edges = [];
      const nodes = [{ id: 'hub', type: 'Domain', properties: {} }];
      
      // Create 5 connections to hub
      for (let i = 0; i < 5; i++) {
        const nodeId = `node_${i}`;
        nodes.push({ id: nodeId, type: 'IP', properties: {} });
        edges.push({ id: `e${i}`, source: 'hub', target: nodeId, label: 'link', properties: {} });
      }

      const graph = { nodes, edges } as any;
      const stats = calculateStats(graph);

      expect(stats.hubNodes).toBe(1); // hub has degree 5
    });

    it('should calculate density', () => {
      // Complete graph with 3 nodes (all connected)
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'IP', properties: {} },
          { id: 'n3', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'link', properties: {} },
          { id: 'e2', source: 'n2', target: 'n3', label: 'link', properties: {} },
          { id: 'e3', source: 'n1', target: 'n3', label: 'link', properties: {} },
        ],
      } as any;

      const stats = calculateStats(graph);
      // Density = 2E / (V * (V-1)) = 2*3 / (3*2) = 1.0
      expect(stats.density).toBe(1);
    });

    it('should count connected components', () => {
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'IP', properties: {} },
          { id: 'n3', type: 'IP', properties: {} }, // isolated
          { id: 'n4', type: 'IP', properties: {} },
          { id: 'n5', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'link', properties: {} },
          { id: 'e2', source: 'n4', target: 'n5', label: 'link', properties: {} },
        ],
      } as any;

      const stats = calculateStats(graph);
      expect(stats.connectedComponents).toBe(3); // {n1,n2}, {n3}, {n4,n5}
    });
  });

  describe('getTopHubs', () => {
    it('should return nodes sorted by degree', () => {
      const graph = {
        nodes: [
          { id: 'small', type: 'IP', properties: {} },
          { id: 'medium', type: 'Domain', properties: {} },
          { id: 'large', type: 'Org', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'large', target: 'small', label: 'link', properties: {} },
          { id: 'e2', source: 'large', target: 'medium', label: 'link', properties: {} },
          { id: 'e3', source: 'medium', target: 'small', label: 'link', properties: {} },
        ],
      } as any;

      const hubs = getTopHubs(graph, 3);
      
      expect(hubs).toHaveLength(3);
      expect(hubs[0].node.id).toBe('large'); // degree 2
      expect(hubs[0].degree).toBe(2);
    });

    it('should limit results', () => {
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'IP', properties: {} },
          { id: 'n3', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'link', properties: {} },
          { id: 'e2', source: 'n2', target: 'n3', label: 'link', properties: {} },
        ],
      } as any;

      const hubs = getTopHubs(graph, 2);
      expect(hubs).toHaveLength(2);
    });
  });

  describe('getIsolatedNodes', () => {
    it('should return nodes with no edges', () => {
      const graph = {
        nodes: [
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'Domain', properties: {} },
          { id: 'n3', type: 'IP', properties: {} }, // isolated
        ],
        edges: [
          { id: 'e1', source: 'n1', target: 'n2', label: 'link', properties: {} },
        ],
      } as any;

      const isolated = getIsolatedNodes(graph);
      expect(isolated).toHaveLength(1);
      expect(isolated[0].id).toBe('n3');
    });
  });

  describe('calculateCentrality', () => {
    it('should calculate normalized degree centrality', () => {
      const graph = {
        nodes: [
          { id: 'center', type: 'Domain', properties: {} },
          { id: 'n1', type: 'IP', properties: {} },
          { id: 'n2', type: 'IP', properties: {} },
        ],
        edges: [
          { id: 'e1', source: 'center', target: 'n1', label: 'link', properties: {} },
          { id: 'e2', source: 'center', target: 'n2', label: 'link', properties: {} },
        ],
      } as any;

      const centrality = calculateCentrality(graph);
      
      expect(centrality.get('center')).toBeCloseTo(1.0, 1); // Connected to all
      expect(centrality.get('n1')).toBeCloseTo(0.5, 1); // Connected to 1 of 2 others
    });
  });

  describe('formatStats', () => {
    it('should format statistics as string', () => {
      const stats = {
        totalNodes: 10,
        totalEdges: 15,
        nodesByType: { IP: 5, Domain: 3, Org: 2 },
        edgesByLabel: { 'resolves-to': 10, 'related-to': 5 },
        averageDegree: 3.0,
        maxDegree: 8,
        minDegree: 1,
        isolatedNodes: 2,
        hubNodes: 1,
        density: 0.33,
        connectedComponents: 2,
      };

      const { formatStats } = require('../utils/graphStats');
      const formatted = formatStats(stats);

      expect(formatted).toContain('Graph Statistics');
      expect(formatted).toContain('Nodes: 10');
      expect(formatted).toContain('Edges: 15');
      expect(formatted).toContain('IP: 5');
    });
  });
});

// ── Integration Tests ─────────────────────────────────────────────────────────

describe('Integration Tests', () => {
  beforeEach(() => {
    graphStore.setGraph({ nodes: [], edges: [] });
    annotationStore.clear();
    tagStore.clear();
    resetFilters();
  });

  it('should handle complete workflow', () => {
    // 1. Create node
    const node = createTestNode('Domain', 'example.com');
    node.provenance = createManualProvenance('tester');
    graphStore.addNode(node);

    // 2. Add tag
    const tag = tagStore.add({ name: 'Important', color: '#f00' });
    tagStore.applyToEntity(tag.id, node.id, 'node');

    // 3. Add annotation
    annotationStore.add({
      entityId: node.id,
      entityType: 'node',
      text: 'Key finding',
      color: 'yellow',
      createdBy: 'tester',
      pinned: true,
    });

    // 4. Verify all present
    const graph = graphStore.snapshot();
    expect(graph.nodes).toHaveLength(1);
    expect(graph.nodes[0].provenance).toBeDefined();
    
    const tags = tagStore.getForEntity(node.id);
    expect(tags).toHaveLength(1);
    
    const annotations = annotationStore.getByEntity(node.id);
    expect(annotations).toHaveLength(1);
    expect(annotations[0].pinned).toBe(true);
  });

  it('should filter graph with annotations and tags', () => {
    // Create nodes
    const node1 = createTestNode('IP', '1.1.1.1');
    const node2 = createTestNode('Domain', 'example.com');
    
    graphStore.addNode(node1);
    graphStore.addNode(node2);

    // Tag one node
    const tag = tagStore.add({ name: 'Test', color: '#000' });
    tagStore.applyToEntity(tag.id, node1.id, 'node');

    // Filter by type
    filterCriteria.update(c => ({ ...c, nodeTypes: ['IP'] }));
    const filtered = get(filteredGraph);

    expect(filtered.nodes).toHaveLength(1);
    expect(filtered.nodes[0].id).toBe(node1.id);
  });
});
